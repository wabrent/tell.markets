# Скопируй этот файл в .env и впиши свои значения. .env никогда не коммить и никому не присылай.

# Порт сайта
PORT=3000

# Публичный адрес сайта (для превью-карточек в X). Локально можно оставить пустым.
PUBLIC_URL=https://tell.markets

# RPC Robinhood Chain. Публичный подходит для тестов; для продакшена — платный (QuickNode / Chainstack / Dwellir)
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# AI-разбор сайта и вердикт. Достаточно одного ключа; если заданы оба, используется DeepSeek.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
ANTHROPIC_API_KEY=

# Лента «Launches today»: фоновая проверка новых запусков Pons. off — выключить.
LAUNCH_WATCHER=on

# $TELL: адрес токена после запуска. Пока пусто — привилегии держателей выключены.
TELL_TOKEN=
# Сколько $TELL нужно для безлимита
TELL_HOLDER_MIN=100000
# Бесплатных новых проверок в день без $TELL. 0 — без лимита (рекомендуется до запуска токена)
FREE_CHECKS_PER_DAY=0

# ---------- API для агентов (/api/v1, /mcp) ----------
# Бесплатных полных проверок в день на одного вызывающего, дальше — оплата x402
FREE_FULL_PER_DAY=5

# ---------- Оплата x402 в USDG (Robinhood Chain) ----------
# Пусто = оплата выключена, всё бесплатно.
# Казна: публичный адрес, куда приходят USDG
X402_PAY_TO=
# Цена полной проверки в USDG
X402_PRICE_FULL=0.03
# Ключ ОТДЕЛЬНОГО кошелька, на котором только немного ETH на газ (он проводит переводы USDG). Не основной кошелёк!
X402_SETTLER_KEY=
# Вместо ключа можно указать внешний x402-фасилитатор (с /verify и /settle)
X402_FACILITATOR_URL=

# ---------- Журнал вердиктов on-chain ----------
# Ключ кошелька с газом, который раз в час пишет корень в сеть. Пусто = берётся X402_SETTLER_KEY
PROOF_KEY=

# ---------- Боты ----------
# Telegram: токен от @BotFather; канал (@имя или id), куда постятся запуски
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=
TELEGRAM_MIN_HOLDERS=25
# X (Twitter): ключи приложения и access token аккаунта Tell (OAuth 1.0a, права Read and Write)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Час (UTC) ежедневного поста «Launches today»
X_DIGEST_HOUR=18
