# Скопируй этот файл в .env и впиши свои значения. .env никогда не коммить и никому не присылай.

# Порт сайта
PORT=3000

# RPC Robinhood Chain. Публичный подходит для тестов; для продакшена — платный (QuickNode / Chainstack / Dwellir)
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# AI-разбор сайта и вердикт. Достаточно одного ключа; если заданы оба, используется DeepSeek.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
ANTHROPIC_API_KEY=
