# Скопируй этот файл в .env и впиши свои значения. .env никогда не коммить и никому не присылай.

# Порт сайта
PORT=3000

# Публичный адрес сайта (для превью-карточек в X). Локально можно оставить пустым.
PUBLIC_URL=https://tell.markets

# RPC Robinhood Chain. Публичный подходит для тестов; для продакшена — платный (QuickNode / Chainstack / Dwellir)
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# AI-разбор сайта и вердикт. Достаточно одного ключа; если заданы оба, используется DeepSeek.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
ANTHROPIC_API_KEY=

# Лента «Launches today»: фоновая проверка новых запусков Pons. off — выключить.
LAUNCH_WATCHER=on

# $TELL: адрес токена после запуска. Пока пусто — привилегии держателей выключены.
TELL_TOKEN=
# Сколько $TELL нужно для безлимита
TELL_HOLDER_MIN=100000
# Бесплатных новых проверок в день без $TELL. 0 — без лимита (рекомендуется до запуска токена)
FREE_CHECKS_PER_DAY=0
